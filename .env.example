APP_ENV=development
APP_NAME=gopass
APP_URL=http://localhost:8080
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Database. Use EITHER the single DB_DSN below OR the DB_* parts (DB_DSN wins when both are set).
# The migrator creates the database if it is missing and always enables multiStatements itself.
DB_DSN=root:password@tcp(127.0.0.1:3306)/gopass?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# Optional: where the migration files live (default: ./migrations, so run from the project root)
# MIGRATIONS_DIR=migrations
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=gopass
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
