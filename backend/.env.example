APP_ENV=development
APP_NAME=gopass
APP_URL=http://localhost:8080
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Database. Use EITHER the single DB_DSN below OR the DB_* parts (DB_DSN wins when both are set).
# The migrator creates the database if it is missing and always enables multiStatements itself.
DB_DSN=root:password@tcp(127.0.0.1:3306)/gopass?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# Optional: where the migration files live (default: ./migrations, so run from the project root)
# MIGRATIONS_DIR=migrations
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=gopass
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# Notification email delivery (durable queue retries when SMTP is temporarily unavailable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GoPass <no-reply@example.com>

# Required only to save dedicated-tenant database credentials; raw 32 bytes or base64 of 32 random bytes.
# Generate a random value, keep it outside source control, and back it up securely.
PLATFORM_DB_ENCRYPTION_KEY=
# Bootstrap platform admin after migration 0009: set these in the shell, then run
# go run ./cmd/platform-admin-create (never commit these values).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=
